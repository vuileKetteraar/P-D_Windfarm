    Block {
      BlockType		      SubSystem
      Name		      "Faults"
      SID		      "11"
      Ports		      [0, 0, 0, 0, 0, 3]
      Position		      [589, 245, 651, 295]
      BlockRotation	      270
      BlockMirror	      on
      ForegroundColor	      "red"
      MinAlgLoopOccurrences   off
      PropExecContextOutsideSubsystem off
      RTWSystemCode	      "Auto"
      FunctionWithSeparateData off
      Opaque		      off
      RequestExecContextInheritance off
      MaskHideContents	      off
      MaskPromptString	      "Type of fault|Fault time (in sec.)|Fault Resistance RF (in ohms)"
      MaskStyleString	      "popup('Normal'|'A-G'|'B-G'|'C-G'|'B-C'|'A-C'|'A-B'|'A-B-C'|'B-C-G'|'A-C-G'|'A-B-G'|'A-B-C"
      "-G'),edit,edit"
      MaskVariables	      "tof=@1;ft=@2;RF=@3;"
      MaskTunableValueString  "on,on,on"
      MaskCallbackString      "||"
      MaskEnableString	      "on,on,on"
      MaskVisibilityString    "on,on,on"
      MaskToolTipString	      "on,on,on"
      MaskInitialization      "\nswitch tof,\n   case 1,\n      %No faults or Normal\n      S1=0;S2=0;S3=0;S4=0;\n   c"
      "ase 2,\n      %Fault A-G\n      S1=1;S2=0;S3=0;S4=1;\n   case 3,\n      %Fault B-G\n      S1=0;S2=1;S3=0;S4=1;\n"
      "   case 4,\n      %Fault B-G\n      S1=0;S2=0;S3=1;S4=1;\n   case 5,\n      %Fault B-C\n      S1=0;S2=1;S3=1;S4="
      "0;\n   case 6,\n      %Fault A-C\n      S1=1;S2=0;S3=1;S4=0;\n   case 7,\n      %Fault A-B\n      S1=1;S2=1;S3=0"
      ";S4=0;\n   case 8,\n      %Fault A-B-C\n      S1=1;S2=1;S3=1;S4=0;\n   case 9,\n      %Fault B-C-G\n      S1=0;S"
      "2=1;S3=1;S4=1;\n   case 10,\n      %Fault A-C-G\n      S1=1;S2=0;S3=1;S4=1;\n   case 11,\n      %Fault A-B-G\n  "
      "    S1=1;S2=1;S3=0;S4=1;\n   case 12,\n      %Fault A-B-C-G\n      S1=1;S2=1;S3=1;S4=1;\n   end;\n"
      MaskDisplay	      "plot(0,0,100,100,[44,47,56,38,50],[23,8,64,44,97],[56,47],[25,8])"
      MaskIconFrame	      off
      MaskIconOpaque	      on
      MaskIconRotate	      "none"
      MaskPortRotate	      "default"
      MaskIconUnits	      "autoscale"
      MaskValueString	      "'A-G'|0.05|1e-6"
