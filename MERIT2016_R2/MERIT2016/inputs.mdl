    Block {
      BlockType		      SubSystem
      Name		      "Analytical \nGenerator"
      Ports		      [0, 1, 0, 0, 0]
      Position		      [35, 12, 90, 68]
      BackgroundColor	      "lightBlue"
      ShowPortLabels	      on
      MaskType		      "Analytical Generator"
      MaskDescription	      "Generates any signal by providing the equation "
"describing the output value. The time variable must be named tx. The start-up"
" time must be specified."
      MaskHelp		      "web(['file:///' which('agdoc.html')]);\n"
      MaskPromptString	      "Generated function|Start-up time [sec]"
      MaskStyleString	      "edit,edit"
      MaskTunableValueString  "on,on"
      MaskCallbackString      "|"
      MaskEnableString	      "on,on"
      MaskVisibilityString    "on,on"
      MaskVariables	      "y=&1;to=@2;"
      MaskInitialization      "t = 0:0.001:0.1;\n\nfor i = 1:length(t)\n  if t"
"(i) < to\n    x(i) = 0;\n  else\n    tx = t(i) - to;\n    x(i) =  eval(y);\n "
" end\nend\n"
      MaskDisplay	      "plot(t,x);"
      MaskIconFrame	      on
      MaskIconOpaque	      off
      MaskIconRotate	      "port"
      MaskIconUnits	      "autoscale"
      MaskValueString	      "10*cos(2*pi*60*tx)|1/60"
      System {
	Name			"Analytical \nGenerator"
	Location		[72, 349, 350, 515]
	Open			off
	ModelBrowserVisibility	off
	ModelBrowserWidth	200
	ScreenColor		"white"
	PaperOrientation	"landscape"
	PaperPositionMode	"auto"
	PaperType		"usletter"
	PaperUnits		"inches"
	ZoomFactor		"100"
	AutoZoom		on
	Block {
	  BlockType		  "S-Function"
	  Name			  "S-Function"
	  Ports			  [0, 1, 0, 0, 0]
	  Position		  [65, 62, 125, 108]
	  FunctionName		  "ag1"
	  Parameters		  "y,to"
	  PortCounts		  "[]"
	  SFunctionModules	  "''"
	}
	Block {
	  BlockType		  Outport
	  Name			  "      \n       "
	  Position		  [185, 78, 215, 92]
	  Port			  "1"
	  OutputWhenDisabled	  "held"
	  InitialOutput		  "[]"
	}
	Line {
	  SrcBlock		  "S-Function"
	  SrcPort		  1
	  DstBlock		  "      \n       "
	  DstPort		  1
	}
      }
    }
    Block {
      BlockType		      SubSystem
      Name		      "Fault Signal"
      Ports		      [0, 2, 0, 0, 0]
      Position		      [450, 15, 515, 75]
      BackgroundColor	      "lightBlue"
      ShowPortLabels	      on
      MaskType		      "Fault Signal Generator"
      MaskDescription	      "Generates a signal which evolves from a given p"
"re-fault phasor to a given post-fault phasor. A limited number of decaying hi"
"gh frequency components are included. The d.c. component is also included. Th"
"e start-up time may be specified."
      MaskHelp		      "web(['file:///' which('fsgdoc.html')]);\n"
      MaskPromptString	      "Pre-fault amplitude and phase [degrees]|Fault a"
"mplitude and phase [degrees]|Frequency [Hz], fault time and DC time constant|"
"Amplitudes of the oscillatory components|Frequencies of the oscillatory compo"
"nents|Time constants of the oscillatory components"
      MaskStyleString	      "edit,edit,edit,edit,edit,edit"
      MaskTunableValueString  "on,on,on,on,on,on"
      MaskCallbackString      "|||||"
      MaskEnableString	      "on,on,on,on,on,on"
      MaskVisibilityString    "on,on,on,on,on,on"
      MaskVariables	      "pre_fault=@1;post_fault=@2;fr_dc=@3;oscA=@4;osc"
"f=@5;oscT=@6;"
      MaskInitialization      "tx=0:4*fr_dc(2)/100:4*fr_dc(2);\nout(1:26)=pre_"
"fault(1)*cos(2*pi*fr_dc(1)*tx(1:26)+pre_fault(2)*pi/180);\na=out(26);\nout(26"
":101)=post_fault(1)*cos(2*pi*fr_dc(1)*tx(26:101)+post_fault(2)*pi/180);\nAdc="
"a-out(26);\nfor  k = 26:101\n      wt=2.*pi.*(tx(k)-fr_dc(2)).*oscf;\n      o"
"sc(k)=sum(oscA.*exp(-(tx(k)-fr_dc(2))./oscT).*sin(wt));\nend\nout(26:101)=out"
"(26:101)+Adc*exp(-(tx(26:101)-fr_dc(2))/fr_dc(3))+osc(26:101);\n\n"
      MaskDisplay	      "plot(tx,out);"
      MaskIconFrame	      on
      MaskIconOpaque	      on
      MaskIconRotate	      "none"
      MaskIconUnits	      "autoscale"
      MaskValueString	      "[10 45]|[2 90]|[60 1.25/60 0.0004]|[1.0 0.8 0.9"
"]|[1000 3000 8000]|[0.050 0.030 0.060]"
      System {
	Name			"Fault Signal"
	Location		[159, 52, 479, 241]
	Open			off
	ModelBrowserVisibility	off
	ModelBrowserWidth	200
	ScreenColor		"white"
	PaperOrientation	"landscape"
	PaperPositionMode	"auto"
	PaperType		"usletter"
	PaperUnits		"inches"
	ZoomFactor		"100"
	AutoZoom		on
