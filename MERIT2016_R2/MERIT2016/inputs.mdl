    Block {
      BlockType		      SubSystem
      Name		      "Phasor\n Generator"
      Ports		      [0, 2, 0, 0, 0]
      Position		      [240, 16, 295, 74]
      BackgroundColor	      "lightBlue"
      ShowPortLabels	      on
      MaskType		      "Phasor Generator"
      MaskDescription	      "Generates a pure sinusoid waveform. The paramet"
"ers of the output signal that have to be specified include amplitude, phase a"
"nd frequency as well as the start-up time.."
      MaskHelp		      "web(['file:///' which('pgdoc.html')]);\n"
      MaskPromptString	      "Phasor   [amplitude, phase in degree]|Frequency"
" [Hz]|Start time [sec]"
      MaskStyleString	      "edit,edit,edit"
      MaskTunableValueString  "on,on,on"
      MaskCallbackString      "||"
      MaskEnableString	      "on,on,on"
      MaskVisibilityString    "on,on,on"
      MaskVariables	      "phase1=@1;f=@2;to=@3;"
      MaskInitialization      "xo  = 0;\nyo  = 0;\nAmax = abs(phase1(1));\nx1 "
"= phase1(1)*cos(phase1(2)*pi/180);\ny1 = phase1(1)*sin(phase1(2)*pi/180);\n"
      MaskDisplay	      "plot([0 0], [ 0  Amax/8]);\nplot([0 0], [3*Amax"
"/8 5*Amax/8]);\nplot([0 0], [7*Amax/8 Amax]);\nplot([0 0], [0 -Amax/8]);\nplo"
"t([0 0], [-3*Amax/8 -5*Amax/8]);\nplot([0 0], [-7*Amax/8 -Amax]);\n\nplot([ 0"
"  Amax/8], [0 0]);\nplot([3*Amax/8 5*Amax/8], [0 0]);\nplot([7*Amax/8 Amax], "
"[0 0]);\nplot([0 -Amax/8], [0 0]);\nplot([-3*Amax/8 -5*Amax/8], [ 0 0]);\nplo"
"t([-7*Amax/8 -Amax], [0 0]);\n\nplot([xo x1], [yo y1]);\n\n\n"
      MaskIconFrame	      on
      MaskIconOpaque	      off
      MaskIconRotate	      "port"
      MaskIconUnits	      "autoscale"
      MaskValueString	      "[10 45]|60|1.25/60"
      System {
