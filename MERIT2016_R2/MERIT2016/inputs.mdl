    Block {
      BlockType		      SubSystem
      Name		      "Spectrum\nGenerator"
      Ports		      [0, 2, 0, 0, 0]
      Position		      [135, 14, 195, 81]
      BackgroundColor	      "lightBlue"
      ShowPortLabels	      on
      MaskType		      "Spectrum Generator"
      MaskDescription	      "Generates a signal composed from the limited nu"
"mber of harmonics and sub-harmonics including the d.c. component. For each si"
"gnal component, the amplitude, phase and harmonic order are the parameters. T"
"he start-up time may be specified. The frequency for each component expressed"
" as multiple of the fundamental frequency is specyfied in the frequency multi"
"pliers array."
      MaskHelp		      "web(['file:///' which('scdoc.html')]);\n"
      MaskPromptString	      "Fundamental frequency [Hz]|Frequency multiplier"
"s|Amplitudes|Phases [deg]|Start-up time [sec]"
      MaskStyleString	      "edit,edit,edit,edit,edit"
      MaskTunableValueString  "on,on,on,on,on"
      MaskCallbackString      "||||"
      MaskEnableString	      "on,on,on,on,on"
      MaskVisibilityString    "on,on,on,on,on"
      MaskVariables	      "f=@1;m=@2;A=@3;ph=@4;to=@5;"
      MaskInitialization      "for i = 1:3:3*length(A)\n   x(i)   = i;\n   x(i"
"+1) = i;\n   x(i+2) = i;\nend\n\nW = zeros(length(A),3);\nW(:,2) = A';\nW = W"
"';\nfor i = 1:3*length(A)\n   y(i) = W(i);\nend\n"
      MaskDisplay	      "plot(x,y);\n\n\n\n\n\n"
      MaskIconFrame	      on
      MaskIconOpaque	      off
      MaskIconRotate	      "port"
      MaskIconUnits	      "autoscale"
      MaskValueString	      "60|[0 1/3 1 2 5]|[0.1 0.2 1 0.25 0.15]|[0 0 0 3"
"0 45]|1/60"
      System {
	Name			"Spectrum\nGenerator"
	Location		[213, 184, 446, 369]
