    Block {
      BlockType		      SubSystem
      Name		      "Three-phase Phasor \n Generator"
      Ports		      [0, 4, 0, 0, 0]
      Position		      [340, 13, 405, 72]
      BackgroundColor	      "lightBlue"
      ShowPortLabels	      on
      MaskType		      "Three-phase phasor generator"
      MaskDescription	      "Generates three pure sinusoid waveforms. The pa"
"rameters of the output signals to be specified include amplitude and phase fo"
"r each phasor as well as the frequency and the start-up time. The phasors may"
" be set either as phase or symmetrical component values."
      MaskHelp		      "web(['file:///' which('tpgdoc.html')]);\n"
      MaskPromptString	      "Three-phase phasors |Phasor (A or 0);  [amplitu"
"de, phase in degree]|Phasor (B or 1);  [amplitude, phase in degree]|Phasor (C"
" or 2);  [amplitude, phase in degree]|Frequency [Hz]|Start-up time [sec]"
      MaskStyleString	      "popup(Phase quantities-symmetrical|Phase quanti"
"ties-unsymmetrical|Symmetrical components),edit,edit,edit,edit,edit"
      MaskTunableValueString  "on,on,on,on,on,on"
      MaskCallbackString      "|||||"
      MaskEnableString	      "on,on,on,on,on,on"
      MaskVisibilityString    "on,on,on,on,on,on"
      MaskVariables	      "phase_type=@1;phase1=@2;phase2=@3;phase3=@4;f=@"
"5;to=@6;"
      MaskInitialization      "TPG2\n"
      MaskDisplay	      "plot([0 0], [ 0  Amax/8]);\nplot([0 0], [3*Amax"
"/8 5*Amax/8]);\nplot([0 0], [7*Amax/8 Amax]);\nplot([0 0], [0 -Amax/8]);\nplo"
"t([0 0], [-3*Amax/8 -5*Amax/8]);\nplot([0 0], [-7*Amax/8 -Amax]);\n\nplot([ 0"
"  Amax/8], [0 0]);\nplot([3*Amax/8 5*Amax/8], [0 0]);\nplot([7*Amax/8 Amax], "
"[0 0]);\nplot([0 -Amax/8], [0 0]);\nplot([-3*Amax/8 -5*Amax/8], [ 0 0]);\nplo"
"t([-7*Amax/8 -Amax], [0 0]);\n\nplot([xo x1], [yo y1], [xo x2], [yo y2], [xo "
"x3], [yo y3]);\n\n\n\n\n"
      MaskIconFrame	      on
      MaskIconOpaque	      off
      MaskIconRotate	      "port"
      MaskIconUnits	      "autoscale"
      MaskValueString	      "Phase quantities-symmetrical|[10 45]|[0 150]|[0"
" -50]|60|0"
