      BlockType		      SubSystem
      Name		      "CT2"
      SID		      "143"
      Ports		      [0, 1, 0, 0, 0, 3, 3]
      Position		      [417, 315, 488, 355]
      ZOrder		      -6
      BlockRotation	      270
      BlockMirror	      on
      BackgroundColor	      "yellow"
      RequestExecContextInheritance off
      Object {
	$PropName		"MaskObject"
	$ObjectID		30
	$ClassName		"Simulink.Mask"
	Type			"3-phase Current Transformer"
	Description		"This block implements a three phase Saturable transformer by using three mono-phase saturable transform"
	"ers.\nWinding one is connected in Y configuration with neutral connected to the ground.\nWinding two is connected in "
	"Y configuration with neutral connected to ground.\nEnter the saturation characteristic for one mono-phase saturable t"
	"ransformer. The saturation characteristic is the same for A,B, and C  phases. \nFor flux initialization, you  can eit"
	"her specify a vector of three resisual fluxes, or use automatic initialization  corresponding to steady state by ente"
	"ring the string 'auto'."
	Initialization		"pnom=pf(1)/3; fnom=pf(2);\nu1=urx1(1)/sqrt(3); r1=urx1(2); x1=urx1(3);\nu2=urx2(1)/sqrt(3); r2=urx2("
	"2); x2=urx2(3);\nif  isstr(phi0) & strcmp(phi0,'auto')\n   Rm_phi0_1=Rm;\n   Rm_phi0_2=Rm;\n   Rm_phi0_3=Rm;\nelse\n "
	"  Rm_phi0_1=[Rm phi0(1)];\n   Rm_phi0_2=[Rm phi0(2)];\n   Rm_phi0_3=[Rm phi0(3)];\nend\n\n\n\n\n"
	SelfModifiable		"on"
	Display			"\n "
	IconOpaque		"transparent"
	IconRotate		"port"
	Array {
	  Type			  "Simulink.MaskParameter"
	  Dimension		  6
	  Object {
	    $ObjectID		    31
	    Type		    "edit"
	    Name		    "pf"
	    Prompt		    "[Three-phase rated power(VA)  Frequency (Hz)]"
	    Value		    "[6000 60 ]"
	  }
	  Object {
	    $ObjectID		    32
	    Type		    "edit"
	    Name		    "urx1"
	    Prompt		    "Winding 1 (Yg) :    [Ph-Ph Voltage(Vrms)  R(pu)  X(pu)] :"
	    Value		    "[5  0.002 0.08 ]"
	  }
	  Object {
	    $ObjectID		    33
	    Type		    "edit"
	    Name		    "urx2"
	    Prompt		    "Winding 2 (Yg) :    [Ph-Ph voltage(Vrms)  R(pu)  X(pu)] :"
	    Value		    "[2000 0.002 0.08]  "
	  }
	  Object {
	    $ObjectID		    34
	    Type		    "edit"
	    Name		    "sat"
	    Prompt		    "Saturation characterstic [i1(pu) phi1(pu); i2 phi2; ...]"
	    Value		    "[0 0; 1 1.1; 2 1.2; 1000 1.3; 10000 1.35; 100000 1.4]"
	  }
	  Object {
	    $ObjectID		    35
	    Type		    "edit"
	    Name		    "Rm"
	    Prompt		    "Core loss resistance Rm (pu) : "
	    Value		    "1"
	  }
	  Object {
	    $ObjectID		    36
	    Type		    "edit"
	    Name		    "phi0"
	    Prompt		    "Residual fluxes (pu)  [phi0A  phi0B phi0C] or 'auto' "
	    Value		    "'auto'"
	  }
	  PropName		  "Parameters"
	}
      }
