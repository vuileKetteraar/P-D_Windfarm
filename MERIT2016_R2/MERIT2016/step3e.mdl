	    Value		    "0.95"
	  }
	  Object {
	    $ObjectID		    37
	    Type		    "popup"
	    Array {
	      Type		      "Cell"
	      Dimension		      6
	      Cell		      "Time defined"
	      Cell		      "Standard Inverse"
	      Cell		      "Very Inverse"
	      Cell		      "Extra Inverse"
	      Cell		      "RI Inverse"
	      Cell		      "Long Time Inverse"
	      PropName		      "TypeOptions"
	    }
	    Name		    "type1"
	    Prompt		    "Type of Time dependency"
	    Value		    "RI Inverse"
	  }
	  Object {
	    $ObjectID		    38
	    Type		    "popup"
	    Array {
