      Object {
	$PropName		"MaskObject"
	$ObjectID		32
	$ClassName		"Simulink.Mask"
	Type			"Universal Comparator"
	Description		"This block is an Universal Comparator. It can perform a  comparison between a signal an a threshold or "
	"two signals. It can  also emulate some time-signal characteristics.  "
	Initialization		"switch type2,\n   case 1,\n       %signal-threshold\n       if sign ==1\n          %S1>S2\n         "
	" aux=0;\n       else\n          %S1<S2\n          aux=1;\n       end;\n   case 2,\n       %Signal-Signal\n      if si"
	"gn ==1\n          aux=2;\n   	else\n         aux=3;\n      end;\n   case 3,\n      %signal-time\n      if type3==1\n "
	"        %instantaneous value of input signal\n         switch type1,\n            case 1,\n               %time defin"
	"ed\n               aux=4;\n            case 2,\n               %inverse time\n               aux=6;\n            case"
	" 3,\n               %very inverse\n               aux=7;\n            case 4,\n               %extremely inverse\n   "
	"            aux=8;\n            case 5,\n               %RI inverse\n               aux=9;\n            case 6,\n    "
	"           %Long time inverse\n               aux=10;\n            otherwise,\n               aux=0;\n         end;\n"
	"      else\n         switch type1,\n            case 1,\n               %time defined\n               aux=5;\n       "
	"     case 2,\n               %inverse time\n               aux=11;\n            case 3,\n               %very inverse"
	"\n               aux=12;\n            case 4,\n               %extremely inverse\n               aux=13;\n           "
	" case 5,\n               %RI inverse\n               aux=14;\n            case 6,\n               %Long time inverse\n"
	"               aux=15;\n            otherwise,\n               aux=0;\n         end;\n      end;\n   otherwise,\n    "
	"     aux=0;\nend;\n"
	Display			"disp('UC');"
	IconOpaque		"off"
	IconRotate		"port"
	Array {
	  Type			  "Simulink.MaskParameter"
	  Dimension		  8
	  Object {
	    $ObjectID		    33
	    Type		    "popup"
	    Array {
	      Type		      "Cell"
	      Dimension		      3
	      Cell		      "Signal-Threshold"
	      Cell		      "Signal-Signal"
	      Cell		      "Signal-Time"
	      PropName		      "TypeOptions"
	    }
	    Name		    "type2"
	    Prompt		    "Type of comparison"
	    Value		    "Signal-Time"
	  }
	  Object {
	    $ObjectID		    34
	    Type		    "popup"
	    Array {
	      Type		      "Cell"
	      Dimension		      2
	      Cell		      ">"
	      Cell		      "<"
	      PropName		      "TypeOptions"
	    }
	    Name		    "sign"
	    Prompt		    "Sign"
	    Value		    ">"
	  }
	  Object {
	    $ObjectID		    35
	    Type		    "edit"
	    Name		    "Ipickup"
