	  DropShadow		  on
	  RequestExecContextInheritance	off
	  Object {
	    $PropName		    "MaskObject"
	    $ObjectID		    43
	    $ClassName		    "Simulink.Mask"
	    Type		    "Overcurrent Protection"
	    Initialization	    "switch typed\ncase 1,\n   string='Time defined';\ncase 2,\n   string='Standard Inverse';\ncas"
