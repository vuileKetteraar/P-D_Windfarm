		    Type		    "Simulink.MaskParameter"
		    Dimension		    2
		    Object {
		    $ObjectID		    454
		    Type		    "edit"
		    Name		    "f1"
		    Prompt		    "Fundamental frequency f1 (Hz):"
		    Value		    "60"
		    }
		    Object {
		    $ObjectID		    455
		    Type		    "edit"
		    Name		    "n"
		    Prompt		    "Harmonic n (0=DC; 1=fundamental; 2=2nd harm;  ...) :"
		    Value		    "1"
		    }
		    PropName		    "Parameters"
		    }
		    }
