    Block {
      BlockType		      SubSystem
      Name		      "Phasor\n Generator"
      SID		      "10"
      Ports		      [0, 2]
      Position		      [240, 16, 295, 74]
      ZOrder		      -3
      BackgroundColor	      "lightBlue"
      RequestExecContextInheritance off
      Object {
	$PropName		"MaskObject"
	$ObjectID		27
	$ClassName		"Simulink.Mask"
	Type			"Phasor Generator"
	Description		"Generates a pure sinusoid waveform. The parameters of the output signal that have to be specified inclu"
	"de amplitude, phase and frequency as well as the start-up time.."
	Initialization		"xo  = 0;\nyo  = 0;\nAmax = abs(phase1(1));\nx1 = phase1(1)*cos(phase1(2)*pi/180);\ny1 = phase1(1)*si"
	"n(phase1(2)*pi/180);\n"
	Display			"plot([0 0], [ 0  Amax/8]);\nplot([0 0], [3*Amax/8 5*Amax/8]);\nplot([0 0], [7*Amax/8 Amax]);\nplot([0 0], "
	"[0 -Amax/8]);\nplot([0 0], [-3*Amax/8 -5*Amax/8]);\nplot([0 0], [-7*Amax/8 -Amax]);\n\nplot([ 0  Amax/8], [0 0]);\npl"
	"ot([3*Amax/8 5*Amax/8], [0 0]);\nplot([7*Amax/8 Amax], [0 0]);\nplot([0 -Amax/8], [0 0]);\nplot([-3*Amax/8 -5*Amax/8]"
	", [ 0 0]);\nplot([-7*Amax/8 -Amax], [0 0]);\n\nplot([xo x1], [yo y1]);\n\n\n"
	IconOpaque		"off"
	IconRotate		"port"
	Array {
	  Type			  "Simulink.MaskParameter"
	  Dimension		  3
	  Object {
	    $ObjectID		    28
	    Type		    "edit"
	    Name		    "phase1"
	    Prompt		    "Phasor   [amplitude, phase in degree]"
	    Value		    "[10 45]"
	  }
	  Object {
	    $ObjectID		    29
	    Type		    "edit"
	    Name		    "f"
	    Prompt		    "Frequency [Hz]"
	    Value		    "60"
	  }
	  Object {
	    $ObjectID		    30
	    Type		    "edit"
	    Name		    "to"
	    Prompt		    "Start time [sec]"
	    Value		    "1.25/60"
	  }
	  PropName		  "Parameters"
	}
      }
