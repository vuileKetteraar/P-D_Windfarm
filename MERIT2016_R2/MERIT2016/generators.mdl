    Block {
      BlockType		      SubSystem
      Name		      "Spectrum\nGenerator"
      SID		      "15"
      Ports		      [0, 2]
      Position		      [135, 14, 195, 81]
      ZOrder		      -4
      BackgroundColor	      "lightBlue"
      RequestExecContextInheritance off
      Object {
	$PropName		"MaskObject"
	$ObjectID		31
	$ClassName		"Simulink.Mask"
	Type			"Spectrum Generator"
	Description		"Generates a signal composed from the limited number of harmonics and sub-harmonics including the d.c. c"
	"omponent. For each signal component, the amplitude, phase and harmonic order are the parameters. The start-up time ma"
	"y be specified. The frequency for each component expressed as multiple of the fundamental frequency is specyfied in t"
	"he frequency multipliers array."
	Initialization		"for i = 1:3:3*length(A)\n   x(i)   = i;\n   x(i+1) = i;\n   x(i+2) = i;\nend\n\nW = zeros(length(A),"
	"3);\nW(:,2) = A';\nW = W';\nfor i = 1:3*length(A)\n   y(i) = W(i);\nend\n"
	Display			"plot(x,y);\n\n\n\n\n\n"
	IconOpaque		"off"
	IconRotate		"port"
	Array {
	  Type			  "Simulink.MaskParameter"
	  Dimension		  5
	  Object {
	    $ObjectID		    32
	    Type		    "edit"
	    Name		    "f"
	    Prompt		    "Fundamental frequency [Hz]"
	    Value		    "60"
	  }
	  Object {
	    $ObjectID		    33
	    Type		    "edit"
	    Name		    "m"
	    Prompt		    "Frequency multipliers"
	    Value		    "[0 1/3 1 2 5]"
	  }
	  Object {
	    $ObjectID		    34
	    Type		    "edit"
	    Name		    "A"
	    Prompt		    "Amplitudes"
	    Value		    "[0.1 0.2 1 0.25 0.15]"
	  }
	  Object {
	    $ObjectID		    35
	    Type		    "edit"
	    Name		    "ph"
	    Prompt		    "Phases [deg]"
	    Value		    "[0 0 0 30 45]"
	  }
	  Object {
	    $ObjectID		    36
	    Type		    "edit"
	    Name		    "to"
	    Prompt		    "Start-up time [sec]"
	    Value		    "1/60"
	  }
	  PropName		  "Parameters"
	}
      }
