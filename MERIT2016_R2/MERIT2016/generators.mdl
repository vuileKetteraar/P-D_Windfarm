    Block {
      BlockType		      SubSystem
      Name		      "Fault Signal"
      SID		      "4"
      Ports		      [0, 2]
      Position		      [450, 15, 515, 75]
      ZOrder		      -2
      BackgroundColor	      "lightBlue"
      RequestExecContextInheritance off
      Object {
	$PropName		"MaskObject"
	$ObjectID		20
	$ClassName		"Simulink.Mask"
	Type			"Fault Signal Generator"
	Description		"Generates a signal which evolves from a given pre-fault phasor to a given post-fault phasor. A limited "
	"number of decaying high frequency components are included. The d.c. component is also included. The start-up time may"
	" be specified."
	Initialization		"tx=0:4*fr_dc(2)/100:4*fr_dc(2);\nout(1:26)=pre_fault(1)*cos(2*pi*fr_dc(1)*tx(1:26)+pre_fault(2)*pi/1"
	"80);\na=out(26);\nout(26:101)=post_fault(1)*cos(2*pi*fr_dc(1)*tx(26:101)+post_fault(2)*pi/180);\nAdc=a-out(26);\nfor "
	" k = 26:101\n      wt=2.*pi.*(tx(k)-fr_dc(2)).*oscf;\n      osc(k)=sum(oscA.*exp(-(tx(k)-fr_dc(2))./oscT).*sin(wt));\n"
	"end\nout(26:101)=out(26:101)+Adc*exp(-(tx(26:101)-fr_dc(2))/fr_dc(3))+osc(26:101);\n\n"
	Display			"plot(tx,out);"
	Array {
	  Type			  "Simulink.MaskParameter"
	  Dimension		  6
	  Object {
	    $ObjectID		    21
	    Type		    "edit"
	    Name		    "pre_fault"
	    Prompt		    "Pre-fault amplitude and phase [degrees]"
	    Value		    "[10 45]"
	  }
	  Object {
	    $ObjectID		    22
	    Type		    "edit"
	    Name		    "post_fault"
	    Prompt		    "Fault amplitude and phase [degrees]"
	    Value		    "[2 90]"
	  }
	  Object {
	    $ObjectID		    23
	    Type		    "edit"
	    Name		    "fr_dc"
	    Prompt		    "Frequency [Hz], fault time and DC time constant"
	    Value		    "[60 1.25/60 0.0004]"
	  }
	  Object {
	    $ObjectID		    24
	    Type		    "edit"
	    Name		    "oscA"
	    Prompt		    "Amplitudes of the oscillatory components"
	    Value		    "[1.0 0.8 0.9]"
	  }
	  Object {
	    $ObjectID		    25
	    Type		    "edit"
	    Name		    "oscf"
	    Prompt		    "Frequencies of the oscillatory components"
	    Value		    "[1000 3000 8000]"
	  }
	  Object {
	    $ObjectID		    26
	    Type		    "edit"
	    Name		    "oscT"
	    Prompt		    "Time constants of the oscillatory components"
	    Value		    "[0.050 0.030 0.060]"
	  }
	  PropName		  "Parameters"
	}
      }
