    Block {
      BlockType		      SubSystem
      Name		      "Analytical \nGenerator"
      SID		      "1"
      Ports		      [0, 1]
      Position		      [35, 12, 90, 68]
      ZOrder		      -1
      BackgroundColor	      "lightBlue"
      RequestExecContextInheritance off
      Object {
	$PropName		"MaskObject"
	$ObjectID		17
	$ClassName		"Simulink.Mask"
	Type			"Analytical Generator"
	Description		"Generates any signal by providing the equation describing the output value. The time variable must be n"
	"amed tx. The start-up time must be specified."
	Initialization		"t = 0:0.001:0.1;\n\nfor i = 1:length(t)\n  if t(i) < to\n    x(i) = 0;\n  else\n    tx = t(i) - to;\n"
	"    x(i) =  eval(y);\n  end\nend\n"
	Display			"plot(t,x);"
	IconOpaque		"off"
	IconRotate		"port"
	Array {
	  Type			  "Simulink.MaskParameter"
	  Dimension		  2
	  Object {
	    $ObjectID		    18
	    Type		    "edit"
	    Name		    "y"
	    Prompt		    "Generated function"
	    Value		    "10*cos(2*pi*60*tx)"
	    Evaluate		    "off"
	  }
	  Object {
	    $ObjectID		    19
	    Type		    "edit"
	    Name		    "to"
	    Prompt		    "Start-up time [sec]"
	    Value		    "1/60"
	  }
	  PropName		  "Parameters"
	}
      }
