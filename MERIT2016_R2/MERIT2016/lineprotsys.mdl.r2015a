		    Value		    "[0 0;0 0;0 0;0 0]"
		  }
		  Object {
		    $ObjectID		    48
		    Type		    "edit"
		    Name		    "fs"
		    Prompt		    "Sampling frecuency (Hz):"
		    Value		    "32*60"
		  }
		  PropName		  "Parameters"
		}
