    Block {
      BlockType		      SubSystem
      Name		      "Synchronous\nMachine\nMeasurements1"
      SID		      "130"
      Ports		      [1, 1]
      Position		      [225, 226, 275, 254]
      ZOrder		      -8
      BackgroundColor	      "yellow"
      RequestExecContextInheritance off
      Object {
	$PropName		"MaskObject"
	$ObjectID		20
	$ClassName		"Simulink.Mask"
	Type			"Synchronous Machine measurements"
	Description		"Select the signals you want to observe.\n\nCAUTION: damper winding currents are referred to the stator."
	Initialization		"s=[v1 v2 v3 v4 v5 v6 v7 v8 v9 v10];\nlaststate=str2num(get_param([gcb,'/last state'],'Value')); % la"
	"st dialog box state\nset_param([gcb,'/last state'],'Value',['[ ',num2str(s),' ]']);\n\nif (sum(abs(laststate-s))) % i"
	"f actual mask differs from last value\n  % Name of output ports which reflect Synchronous Machine outputs\n  names = "
	"{'is_abc','is_qd','ifd','ik_qd','phim_qd','vs_qd','theta','N','Pe','dw'};\n\n  % Position of output ports for neat pr"
	"esentation\n  positions = [ 145    54   165    66\n              145    89   165   101\n              145   124   165"
	"   136\n              145   159   165   171\n              145   194   165   206\n              145   229   165   241"
	"\n              145   264   165   276\n              145   299   165   311\n              145   334   165   346\n    "
	"          145   369   165   381\n            ];\n  % find_system options differ from ver5.0 to 5.1\n  ver=version; ve"
	"r=ver(1:3);\n\n  % erase all existing outports to keep same order all the time\n  for (i=1:length(s))\n    switch(ver"
	")\n      case{'5.1'}\n        if ~isempty(find_system(gcb,'LookUnderMasks','on','Name',names{i}))\n          delete_l"
	"ine(gcb,['Demux/',num2str(i)],[names{i},'/1']);\n          delete_block([gcb,'/',names{i}]);\n        end	% if\n     "
	" case{'5.0'}\n        if ~isempty(find_system(gcb,'Name',names{i}))\n          delete_line(gcb,['Demux/',num2str(i)],"
	"[names{i},'/1']);\n          delete_block([gcb,'/',names{i}]);\n        end	% if\n    end % switch\n  end % for\n\n  "
	"% find outports desired\n  idx=find(s~=0);\n\n  for (i=idx)\n    add_block('built-in/Outport',[gcb,'/',names{i}],'Pos"
	"ition',positions(i,:));\n    add_line(gcb,['Demux/',num2str(i)],[names{i},'/1']);\n  end % for\nend % if"
	IconOpaque		"off"
	Array {
	  Type			  "Simulink.MaskParameter"
	  Dimension		  10
	  Object {
	    $ObjectID		    21
	    Type		    "checkbox"
	    Name		    "v1"
	    Prompt		    "is_abc: stator currents (abc reference frame)"
	    Value		    "on"
	  }
	  Object {
	    $ObjectID		    22
	    Type		    "checkbox"
	    Name		    "v2"
	    Prompt		    "is_qd: stator currents (qd reference frame)"
	    Value		    "off"
	  }
	  Object {
