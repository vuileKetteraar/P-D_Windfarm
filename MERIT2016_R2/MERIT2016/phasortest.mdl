		  BlockType		  SubSystem
		  Name			  "Phasor VA"
		  SID			  "53"
		  Ports			  [1, 2]
		  Position		  [270, 29, 310, 76]
		  ZOrder		  -10
		  BackgroundColor	  "lightBlue"
