		  LibraryVersion	  "*"
		  DialogController	  "POWERSYS.PowerSysDialog"
		  RequestExecContextInheritance	off
		  Object {
		    $PropName		    "MaskObject"
		    $ObjectID		    125
		    $ClassName		    "Simulink.Mask"
		    Type		    "Fourier analyser"
		    Description		    "The Fourier block performs a Fourier analysis of the input signal over a running window of one"
		    " cycle of the fundamental frequency. First and second outputs return respectively the magnitude and phase (degre"
		    "es) of the harmonic component specified."
		    Help		    "web(psbhelp)"
		    Initialization	    "k=2-(n==0);\npower_initmask();"
		    SelfModifiable	    "on"
		    IconOpaque		    "off"
		    Array {
		    Type		    "Simulink.MaskParameter"
		    Dimension		    2
		    Object {
		    $ObjectID		    126
		    Type		    "edit"
		    Name		    "f1"
		    Prompt		    "Fundamental frequency f1 (Hz):"
		    Value		    "60"
		    }
		    Object {
		    $ObjectID		    127
		    Type		    "edit"
		    Name		    "n"
		    Prompt		    "Harmonic n (0=DC; 1=fundamental; 2=2nd harm;  ...) :"
		    Value		    "1"
		    }
		    PropName		    "Parameters"
		    }
		  }
