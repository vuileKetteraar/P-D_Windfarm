		    $PropName		    "MaskObject"
		    $ObjectID		    77
		    $ClassName		    "Simulink.Mask"
		    Type		    "Fourier analyser"
		    Description		    "The Fourier block performs a Fourier analysis of the input signal over a running window of one"
		    " cycle of the fundamental frequency. First and second outputs return respectively the magnitude and phase (degre"
		    "es) of the harmonic component specified."
		    Help		    "web(psbhelp)"
		    Initialization	    "k=2-(n==0);\npower_initmask();"
		    SelfModifiable	    "on"
		    IconOpaque		    "off"
