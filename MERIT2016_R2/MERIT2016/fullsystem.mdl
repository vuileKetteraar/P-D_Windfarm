		    $ObjectID		    342
		    Type		    "popup"
		    Array {
		    Type		    "Cell"
		    Dimension		    4
		    Cell		    "Bessel"
		    Cell		    "Tschebyscheff"
		    Cell		    "Butterworth"
		    Cell		    "free expression"
		    PropName		    "TypeOptions"
		    }
