    Block {
      BlockType		      SubSystem
      Name		      "Faults"
      SID		      "311"
      Ports		      [0, 0, 0, 0, 0, 3]
      Position		      [224, 190, 286, 240]
      ZOrder		      -6
      BlockRotation	      270
      BlockMirror	      on
      ForegroundColor	      "red"
      RequestExecContextInheritance off
      Object {
	$PropName		"MaskObject"
	$ObjectID		24
	$ClassName		"Simulink.Mask"
	Initialization		"\nswitch tof,\n   case 1,\n      %No faults or Normal\n      S1=0;S2=0;S3=0;S4=0;\n   case 2,\n     "
	" %Fault A-G\n      S1=1;S2=0;S3=0;S4=1;\n   case 3,\n      %Fault B-G\n      S1=0;S2=1;S3=0;S4=1;\n   case 4,\n      "
	"%Fault B-G\n      S1=0;S2=0;S3=1;S4=1;\n   case 5,\n      %Fault B-C\n      S1=0;S2=1;S3=1;S4=0;\n   case 6,\n      %"
	"Fault A-C\n      S1=1;S2=0;S3=1;S4=0;\n   case 7,\n      %Fault A-B\n      S1=1;S2=1;S3=0;S4=0;\n   case 8,\n      %F"
	"ault A-B-C\n      S1=1;S2=1;S3=1;S4=0;\n   case 9,\n      %Fault B-C-G\n      S1=0;S2=1;S3=1;S4=1;\n   case 10,\n    "
	"  %Fault A-C-G\n      S1=1;S2=0;S3=1;S4=1;\n   case 11,\n      %Fault A-B-G\n      S1=1;S2=1;S3=0;S4=1;\n   case 12,\n"
	"      %Fault A-B-C-G\n      S1=1;S2=1;S3=1;S4=1;\n   end;\n"
	Display			"plot(0,0,100,100,[44,47,56,38,50],[23,8,64,44,97],[56,47],[25,8])"
	IconFrame		"off"
	Array {
	  Type			  "Simulink.MaskParameter"
	  Dimension		  3
	  Object {
	    $ObjectID		    25
	    Type		    "popup"
	    Array {
	      Type		      "Cell"
	      Dimension		      12
	      Cell		      "'Normal'"
	      Cell		      "'A-G'"
	      Cell		      "'B-G'"
	      Cell		      "'C-G'"
	      Cell		      "'B-C'"
	      Cell		      "'A-C'"
	      Cell		      "'A-B'"
	      Cell		      "'A-B-C'"
	      Cell		      "'B-C-G'"
	      Cell		      "'A-C-G'"
	      Cell		      "'A-B-G'"
	      Cell		      "'A-B-C-G'"
	      PropName		      "TypeOptions"
	    }
	    Name		    "tof"
	    Prompt		    "Type of fault"
	    Value		    "'A-G'"
	  }
	  Object {
	    $ObjectID		    26
	    Type		    "edit"
	    Name		    "ft"
	    Prompt		    "Fault time (in sec.)"
	    Value		    "0.05"
	  }
	  Object {
	    $ObjectID		    27
	    Type		    "edit"
	    Name		    "RF"
	    Prompt		    "Fault Resistance RF (in ohms)"
	    Value		    "1e-6"
	  }
	  PropName		  "Parameters"
	}
      }
